# ══════════════════════════════════════════════════════
#  SMMS – Codespaces Test Environment
#  Copy this file to .env before running docker compose
#  Command: cp .env.codespaces .env
#
#  ⚠️  FOR TESTING ONLY — change passwords before
#  deploying to any real environment
# ══════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=smms_db
DB_USER=smms_user
DB_PASSWORD=Test_SMMS_2024!

# ── Redis ──────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=Test_Redis_2024!

# ── JWT ────────────────────────────────────────────
# 64-byte base64-encoded test key — change for production
JWT_SECRET=dGVzdC1qd3Qtc2VjcmV0LWtleS1mb3ItY29kZXNwYWNlcy10ZXN0aW5nLW9ubHktMjAyNC1zbW1z
JWT_EXPIRY_HOURS=8
JWT_REFRESH_EXPIRY_DAYS=7

# ── Spring Boot ────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
# Codespaces sets its own URL — leave this as localhost for now
APP_BASE_URL=http://localhost

# ── CORS (comma-separated, wildcards allowed) ────
CORS_ALLOWED_ORIGIN_PATTERNS=https://*.app.github.dev,http://localhost,http://localhost:3000

# ── File Upload ────────────────────────────────────
UPLOAD_MAX_SIZE_MB=50
UPLOAD_PATH=/app/uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# ── SLA (hours) ────────────────────────────────────
SLA_CRITICAL_HOURS=4
SLA_HIGH_HOURS=8
SLA_MEDIUM_HOURS=24
SLA_LOW_HOURS=48

# ── Email (disabled in test — mail health check is off) ─
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Logging ────────────────────────────────────────
LOG_LEVEL=INFO
LOG_PATH=/app/logs

# ══════════════════════════════════════════════════════
#  SMMS – Codespaces Test Environment
#  TEMPLATE ONLY. Do not put real secrets in this tracked file.
#  Run `bash setup.sh`: it copies this file to the untracked .env and
#  replaces every __GENERATED_BY_SETUP__ value with a random secret.
#  (Manual use: copy to .env and replace the placeholders yourself.)
#
#  ⚠️  FOR TESTING ONLY — use your own secrets for any real environment
# ══════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=smms_db
DB_USER=smms_user
DB_PASSWORD=__GENERATED_BY_SETUP__

# ── Redis ──────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__GENERATED_BY_SETUP__

# ── JWT ────────────────────────────────────────────
# Base64 random key (>= 32 bytes). The backend refuses to start in prod with a weak or public one.
JWT_SECRET=__GENERATED_BY_SETUP__
JWT_EXPIRY_HOURS=8
JWT_REFRESH_EXPIRY_DAYS=7

# ── Spring Boot ────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
# Codespaces sets its own URL — leave this as localhost for now
APP_BASE_URL=http://localhost

# ── CORS (comma-separated, wildcards allowed) ────
CORS_ALLOWED_ORIGIN_PATTERNS=https://*.app.github.dev,http://localhost,http://localhost:3000

# ── File Upload ────────────────────────────────────
UPLOAD_MAX_SIZE_MB=50
UPLOAD_PATH=/app/uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# ── SLA (hours) ────────────────────────────────────
SLA_CRITICAL_HOURS=4
SLA_HIGH_HOURS=8
SLA_MEDIUM_HOURS=24
SLA_LOW_HOURS=48

# ── Email (disabled in test — mail health check is off) ─
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Logging ────────────────────────────────────────
LOG_LEVEL=INFO
LOG_PATH=/app/logs

{
  "name": "SMMS Dev",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": true
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "postCreateCommand": "bash /workspaces/smms-final/Desktop/SMMS-FINAL/setup.sh",
  "forwardPorts": [80],
  "portsAttributes": {
    "80": {
      "label": "SMMS App",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "remoteUser": "vscode"
}

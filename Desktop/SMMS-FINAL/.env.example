# ══════════════════════════════════════════════════════
#  SMMS – Environment Configuration Template
#  Copy to .env and fill in values
# ══════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=smms_db
DB_USER=smms_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Redis ──────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT ────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_SECRET_HERE_USE_OPENSSL_RAND
JWT_EXPIRY_HOURS=8
JWT_REFRESH_EXPIRY_DAYS=7

# ── Spring Boot ────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
APP_BASE_URL=https://smms.yourdomain.com

# ── File Upload ────────────────────────────────────
UPLOAD_MAX_SIZE_MB=50
UPLOAD_PATH=/app/uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# ── SLA (hours) ────────────────────────────────────
SLA_CRITICAL_HOURS=4
SLA_HIGH_HOURS=8
SLA_MEDIUM_HOURS=24
SLA_LOW_HOURS=48

# ── Email Notifications ────────────────────────────
MAIL_HOST=smtp.yourdomain.com
MAIL_PORT=587
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=CHANGE_ME_MAIL_PASSWORD
MAIL_FROM=SMMS <noreply@yourdomain.com>

# ── Frontend ───────────────────────────────────────
VITE_API_URL=https://smms.yourdomain.com/api

# ── Logging ────────────────────────────────────────
LOG_LEVEL=INFO
LOG_PATH=/app/logs

# ══════════════════════════════════════════════════════
#  SMMS – Environment Configuration
#  للتشغيل المحلي: انسخ هذا الملف إلى .env
#  Windows:  copy .env.example .env
#  Mac/Linux: cp .env.example .env
# ══════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=smms_db
DB_USER=smms_user
# generate: openssl rand -hex 24
DB_PASSWORD=CHANGE_ME

# ── Redis ──────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# generate: openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME

# ── JWT ────────────────────────────────────────────
# generate: openssl rand -base64 48   (>= 32 bytes; the backend refuses weak or public values in prod)
JWT_SECRET=CHANGE_ME
JWT_EXPIRY_HOURS=8
JWT_REFRESH_EXPIRY_DAYS=7

# ── Spring Boot ────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
APP_BASE_URL=http://localhost

# ── CORS (comma-separated, wildcards allowed) ────
# CORS_ALLOWED_ORIGIN_PATTERNS=https://your-domain.example

# ── File Upload ────────────────────────────────────
UPLOAD_MAX_SIZE_MB=50
UPLOAD_PATH=/app/uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# ── SLA (hours) ────────────────────────────────────
SLA_CRITICAL_HOURS=4
SLA_HIGH_HOURS=8
SLA_MEDIUM_HOURS=24
SLA_LOW_HOURS=48

# ── Email (اختياري للتطوير المحلي) ─────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=SMMS <noreply@smms.local>

# ── Feature program 1 (all optional; defaults are safe, nothing external is sent by default) ──
# Public ticket status page. Off unless true. Behind nginx the client IP comes from X-Real-IP.
PUBLIC_STATUS_ENABLED=false
# PUBLIC_STATUS_RATE_LIMIT_PER_MINUTE=30
# PUBLIC_STATUS_LINK_TTL_DAYS=30
# Purchase orders above this total need a manager approval (empty = no limit)
PROCUREMENT_MANAGER_APPROVAL_LIMIT=
# Notification channels (SMTP host/credentials are the MAIL_* variables above)
NOTIFY_EMAIL_ENABLED=false
NOTIFY_SMS_ENABLED=false
SMS_URL=
# secret: set only in the real .env, never commit a value
SMS_TOKEN=
SMS_SENDER_ID=SMMS

# ── Logging ────────────────────────────────────────
LOG_LEVEL=INFO
LOG_PATH=/app/logs

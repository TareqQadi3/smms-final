# ══════════════════════════════════════════════════════
#  SMMS – Environment Configuration
#  للتشغيل المحلي: انسخ هذا الملف إلى .env
#  Windows:  copy .env.example .env
#  Mac/Linux: cp .env.example .env
# ══════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=smms_db
DB_USER=smms_user
# generate: openssl rand -hex 24
DB_PASSWORD=CHANGE_ME

# ── Redis ──────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# generate: openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME

# ── JWT ────────────────────────────────────────────
# generate: openssl rand -base64 48   (>= 32 bytes; the backend refuses weak or public values in prod)
JWT_SECRET=CHANGE_ME
JWT_EXPIRY_HOURS=8
JWT_REFRESH_EXPIRY_DAYS=7

# ── Spring Boot ────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
APP_BASE_URL=http://localhost

# ── CORS (comma-separated, wildcards allowed) ────
# CORS_ALLOWED_ORIGIN_PATTERNS=https://your-domain.example

# ── File Upload ────────────────────────────────────
UPLOAD_MAX_SIZE_MB=50
UPLOAD_PATH=/app/uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# ── SLA (hours) ────────────────────────────────────
SLA_CRITICAL_HOURS=4
SLA_HIGH_HOURS=8
SLA_MEDIUM_HOURS=24
SLA_LOW_HOURS=48

# ── Email (اختياري للتطوير المحلي) ─────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=SMMS <noreply@smms.local>

# ── Logging ────────────────────────────────────────
LOG_LEVEL=INFO
LOG_PATH=/app/logs

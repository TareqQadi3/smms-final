# Runtime-only image using a pre-built JAR from the host.
# Used when Docker build cannot reach Maven Central due to proxy/TLS constraints.
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app

RUN addgroup -S smms && adduser -S smms -G smms

COPY target/smms-backend-1.0.0.jar app.jar

RUN mkdir -p /app/uploads /app/logs && chown -R smms:smms /app

USER smms

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD wget -qO- http://localhost:8080/actuator/health || exit 1

ENTRYPOINT ["java", \
  "-XX:+UseContainerSupport", \
  "-XX:MaxRAMPercentage=75.0", \
  "-Djava.security.egd=file:/dev/./urandom", \
  "-jar", "app.jar"]
